<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:ff="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
             xmlns:vm="clr-namespace:UrGuide.Mobile.ViewModels"
             xmlns:m="clr-namespace:UrGuide.Mobile.Models;assembly=UrGuide.Mobile" xmlns:shared="clr-namespace:UrGuide.Model.Shared;assembly=UrGuide.Model" xmlns:cv="clr-namespace:UrGuide.Mobile.Converters"
             mc:Ignorable="d"
             xmlns:ext="clr-namespace:System.Collections;assembly=netstandard" xmlns:mm="clr-namespace:UrGuide.Model.Posts;assembly=UrGuide.Model"
             x:Class="UrGuide.Mobile.Views.MainPage"
             NavigationPage.HasNavigationBar="False"
             x:DataType="vm:MainPageViewModel"
             >
    <ContentPage.Resources>
        <Color x:Key="IconColor">#3F51B5</Color>
        <Color x:Key="IndicatorColor">#703F51B5</Color>
        <Color x:Key="IndicatorSelectedColor">#3F51B5</Color>
        <Color x:Key="FavoriteIcon">Orange</Color>
        <x:Boolean x:Key="FalseValue" ></x:Boolean>
        <cv:NumericToSocialUnitConverter x:Key="NumericToSocialUnitConverter" />
        <DataTemplate x:DataType="m:PostItem" x:Key="PostModelTemplate">
            <Frame VerticalOptions="StartAndExpand" HorizontalOptions="FillAndExpand"
                   CornerRadius="8" >
                <Grid RowDefinitions="70,Auto,Auto,Auto,*" ColumnDefinitions="70,*" Margin="8,0,8,8">

                    <ff:CachedImage Source="{Binding AuthorAvatar}"
                            Aspect="AspectFit" HeightRequest="46" WidthRequest="46">
                    </ff:CachedImage>
                    
                    <StackLayout Grid.Column="1" VerticalOptions="StartAndExpand" Orientation="Vertical" Spacing="12"
                             Margin="8">
                        <Label Text="{Binding Author}" FontSize="Medium" 
                       FontAttributes="Bold"/>
                        <Label Text="{Binding PublicationDate}" FontSize="Small"/>
                    </StackLayout>
                    <Path
                        Data="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
                        Grid.Column="1"
                        HorizontalOptions="End"
                        Stroke="{StaticResource FavoriteIcon}"
                        StrokeThickness="1"
                        WidthRequest="32"
                        HeightRequest="32"
                        >
                        <Path.Triggers>
                            <DataTrigger TargetType="Path" Binding="{Binding IsBidOptIn}" Value="{Static x:Boolean.TrueString}">
                                <Setter Property="Fill" Value="{StaticResource FavoriteIcon}"/>
                            </DataTrigger>
                        </Path.Triggers>
                    </Path>
                    <StackLayout Grid.Row="1" Grid.ColumnSpan="2" Orientation="Vertical" VerticalOptions="StartAndExpand" Spacing="12">
                        <StackLayout Orientation="Horizontal" Spacing="8">
                            <Path Data="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                                  Stroke="{StaticResource IconColor}"
                                  Fill="{StaticResource IconColor}"
                                  HeightRequest="24" WidthRequest="24"
                                  Aspect="Uniform"/>
                            <Label Text="{Binding Location, StringFormat='Place: {0}'}" FontSize="Medium" FontAttributes="Bold"/>
                        </StackLayout>
                        <StackLayout Orientation="Horizontal" Spacing="8">
                            <Path Data="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"
                                  Stroke="{StaticResource IconColor}"
                                  Fill="{StaticResource IconColor}"
                                  HeightRequest="24" WidthRequest="24"
                                  Aspect="Uniform"/>
                            <Label Text="{Binding Price, StringFormat='Budget: {0}'}" FontSize="Medium" FontAttributes="Bold"/>
                        </StackLayout>
                        <StackLayout Spacing="8" Orientation="Horizontal">
                            <Path Data="M9 13.75c-2.34 0-7 1.17-7 3.5V19h14v-1.75c0-2.33-4.66-3.5-7-3.5zM4.34 17c.84-.58 2.87-1.25 4.66-1.25s3.82.67 4.66 1.25H4.34zM9 12c1.93 0 3.5-1.57 3.5-3.5S10.93 5 9 5 5.5 6.57 5.5 8.5 7.07 12 9 12zm0-5c.83 0 1.5.67 1.5 1.5S9.83 10 9 10s-1.5-.67-1.5-1.5S8.17 7 9 7zm7.04 6.81c1.16.84 1.96 1.96 1.96 3.44V19h4v-1.75c0-2.02-3.5-3.17-5.96-3.44zM15 12c1.93 0 3.5-1.57 3.5-3.5S16.93 5 15 5c-.54 0-1.04.13-1.5.35.63.89 1 1.98 1 3.15s-.37 2.26-1 3.15c.46.22.96.35 1.5.35z"
                                  Aspect="Uniform"
                                  Stroke="{StaticResource IconColor}"
                                  Fill="{StaticResource IconColor}"
                                  HeightRequest="24" WidthRequest="24"/>
                            <Label Text="{Binding Seats, StringFormat='Seats: {0}'}" FontSize="Medium" FontAttributes="Bold"/>
                        </StackLayout>
                        <Path Data="M12.5 8H11v6l4.75 2.85.75-1.23-4-2.37zm4.837-6.19l4.607 3.845-1.28 1.535-4.61-3.843zm-10.674 0l1.282 1.536L3.337 7.19l-1.28-1.536zM12 4c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9-4.03-9-9-9zm0 16c-3.86 0-7-3.14-7-7s3.14-7 7-7 7 3.14 7 7-3.14 7-7 7z"
                              Stroke="{StaticResource IconColor}"
                              Fill="{StaticResource IconColor}"
                              HeightRequest="24" WidthRequest="24"/>
                        <Grid ColumnDefinitions="10,*" RowDefinitions="Auto,*" RowSpacing="5" Margin="10,0,0,0">
                            <BoxView Grid.RowSpan="2" HorizontalOptions="Start" VerticalOptions="StartAndExpand" 
                                     WidthRequest="2"
                                     BackgroundColor="{StaticResource IconColor}"/>
                            <BoxView HorizontalOptions="StartAndExpand"  VerticalOptions="Center" WidthRequest="8" HeightRequest="4"
                                     BackgroundColor="{StaticResource IconColor}"
                                     CornerRadius="4"/>
                            <BoxView Grid.Row="1" HorizontalOptions="StartAndExpand"  VerticalOptions="Center" WidthRequest="8" HeightRequest="4"
                                     BackgroundColor="{StaticResource IconColor}"
                                     CornerRadius="4"/>
                            <Label Grid.Column="1" FontSize="Small" FontAttributes="Bold"  >
                                <Label.FormattedText>
                                    <FormattedString>
                                        <FormattedString.Spans>
                                            <Span Text="{Binding StartDate}"/>
                                            <Span Text=" "/>
                                            <Span Text="{Binding StartTime}"/>
                                        </FormattedString.Spans>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Grid.Column="1" Grid.Row="1" FontSize="Small" FontAttributes="Bold" VerticalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <FormattedString.Spans>
                                            <Span Text="{Binding EndDate}"/>
                                            <Span Text=" "/>
                                            <Span Text="{Binding EndTime}"/>
                                        </FormattedString.Spans>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Grid>
                        
                    </StackLayout>
                    <StackLayout Grid.ColumnSpan="2" Grid.Row="2" VerticalOptions="StartAndExpand" 
                             Orientation="Horizontal" Spacing="8"
                             BindableLayout.ItemsSource="{Binding Categories}"
                             Margin="0,8,0,0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Frame CornerRadius="4" Padding="8" HasShadow="True" BackgroundColor="{StaticResource IconColor}">
                                    <Label Text="{Binding .}" FontSize="Small" FontAttributes="Bold" 
                                           TextColor="White"/>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                    <StackLayout Grid.Row="3" Orientation="Vertical" Grid.ColumnSpan="2"
                             VerticalOptions="StartAndExpand" Spacing="8">
                        <Label Text="{Binding Description}" 
                           VerticalOptions="Start"/>
                        <CarouselView ItemsSource="{Binding Images}" IsSwipeEnabled="True" VerticalOptions="Start" 
                                      HeightRequest="200" PeekAreaInsets="20">
                            <CarouselView.ItemTemplate>
                                <DataTemplate x:DataType="shared:ImageFileModel">
                                    <StackLayout>
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="CurrentItem">
                                                    <VisualState.Setters>
                                                        <Setter Property="Scale"
                                        Value="1.1" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="PreviousItem">
                                                    <VisualState.Setters>
                                                        <Setter Property="Opacity"
                                        Value="0.5" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="NextItem">
                                                    <VisualState.Setters>
                                                        <Setter Property="Opacity"
                                        Value="0.5" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="DefaultItem">
                                                    <VisualState.Setters>
                                                        <Setter Property="Opacity"
                                        Value="0.25" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>

                                        <ff:CachedImage Source="{Binding ImageBase64}" 
                                                    HeightRequest="200"
                                                    Aspect="AspectFit"
                                                    DownsampleToViewSize="True"
                                                    VerticalOptions="Start"/>
                                    </StackLayout>
                                </DataTemplate>
                            </CarouselView.ItemTemplate>
                            <CarouselView.IndicatorView>
                                <IndicatorView IndicatorColor="{StaticResource IndicatorColor}" 
                                               SelectedIndicatorColor="{StaticResource IndicatorSelectedColor}"></IndicatorView>
                            </CarouselView.IndicatorView>
                        </CarouselView>
                        <StackLayout Orientation="Horizontal" Spacing="8">
                            <Path Data="M466.27 286.69C475.04 271.84 480 256 480 236.85c0-44.015-37.218-85.58-85.82-85.58H357.7c4.92-12.81 8.85-28.13 8.85-46.54C366.55 31.936 328.86 0 271.28 0c-61.607 0-58.093 94.933-71.76 108.6-22.747 22.747-49.615 66.447-68.76 83.4H32c-17.673 0-32 14.327-32 32v240c0 17.673 14.327 32 32 32h64c14.893 0 27.408-10.174 30.978-23.95 44.509 1.001 75.06 39.94 177.802 39.94 7.22 0 15.22.01 22.22.01 77.117 0 111.986-39.423 112.94-95.33 13.319-18.425 20.299-43.122 17.34-66.99 9.854-18.452 13.664-40.343 8.99-62.99zm-61.75 53.83c12.56 21.13 1.26 49.41-13.94 57.57 7.7 48.78-17.608 65.9-53.12 65.9h-37.82c-71.639 0-118.029-37.82-171.64-37.82V240h10.92c28.36 0 67.98-70.89 94.54-97.46 28.36-28.36 18.91-75.63 37.82-94.54 47.27 0 47.27 32.98 47.27 56.73 0 39.17-28.36 56.72-28.36 94.54h103.99c21.11 0 37.73 18.91 37.82 37.82.09 18.9-12.82 37.81-22.27 37.81 13.489 14.555 16.371 45.236-5.21 65.62zM88 432c0 13.255-10.745 24-24 24s-24-10.745-24-24 10.745-24 24-24 24 10.745 24 24z" 
                              Stroke="{StaticResource IconColor}" Fill="{StaticResource IconColor}"
                              HeightRequest="24" WidthRequest="24" Aspect="Uniform"
                              HorizontalOptions="Center"/>
                            <Label Text="{Binding Likes, Converter={StaticResource NumericToSocialUnitConverter}}" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Path Data="M466.27 286.69C475.04 271.84 480 256 480 236.85c0-44.015-37.218-85.58-85.82-85.58H357.7c4.92-12.81 8.85-28.13 8.85-46.54C366.55 31.936 328.86 0 271.28 0c-61.607 0-58.093 94.933-71.76 108.6-22.747 22.747-49.615 66.447-68.76 83.4H32c-17.673 0-32 14.327-32 32v240c0 17.673 14.327 32 32 32h64c14.893 0 27.408-10.174 30.978-23.95 44.509 1.001 75.06 39.94 177.802 39.94 7.22 0 15.22.01 22.22.01 77.117 0 111.986-39.423 112.94-95.33 13.319-18.425 20.299-43.122 17.34-66.99 9.854-18.452 13.664-40.343 8.99-62.99zm-61.75 53.83c12.56 21.13 1.26 49.41-13.94 57.57 7.7 48.78-17.608 65.9-53.12 65.9h-37.82c-71.639 0-118.029-37.82-171.64-37.82V240h10.92c28.36 0 67.98-70.89 94.54-97.46 28.36-28.36 18.91-75.63 37.82-94.54 47.27 0 47.27 32.98 47.27 56.73 0 39.17-28.36 56.72-28.36 94.54h103.99c21.11 0 37.73 18.91 37.82 37.82.09 18.9-12.82 37.81-22.27 37.81 13.489 14.555 16.371 45.236-5.21 65.62zM88 432c0 13.255-10.745 24-24 24s-24-10.745-24-24 10.745-24 24-24 24 10.745 24 24z" 
                              Stroke="{StaticResource IconColor}" Fill="{StaticResource IconColor}"
                              HeightRequest="24" WidthRequest="24" Aspect="Uniform" Rotation="180"/>
                            <Label Text="{Binding Dislikes, Converter={StaticResource NumericToSocialUnitConverter}}" HorizontalOptions="Center" VerticalOptions="Center" />
                            <StackLayout Orientation="Horizontal" HorizontalOptions="EndAndExpand" Spacing="24">
                                <Path Data="M256 32C114.6 32 0 125.1 0 240c0 47.6 19.9 91.2 52.9 126.3C38 405.7 7 439.1 6.5 439.5c-6.6 7-8.4 17.2-4.6 26S14.4 480 24 480c61.5 0 110-25.7 139.1-46.3C192 442.8 223.2 448 256 448c141.4 0 256-93.1 256-208S397.4 32 256 32zm0 368c-26.7 0-53.1-4.1-78.4-12.1l-22.7-7.2-19.5 13.8c-14.3 10.1-33.9 21.4-57.5 29 7.3-12.1 14.4-25.7 19.9-40.2l10.6-28.1-20.6-21.8C69.7 314.1 48 282.2 48 240c0-88.2 93.3-160 208-160s208 71.8 208 160-93.3 160-208 160z"
                              Stroke="{StaticResource IconColor}" Fill="{StaticResource IconColor}"
                              HeightRequest="24" WidthRequest="24" Aspect="Uniform" Rotation="180"/>
                                <Label Text="{Binding BidCount}" FontAttributes="Bold"
                                       Margin="-20,0,0,0" TranslationY="-8" TextColor="{StaticResource IconColor}"/>
                                <Path Data="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                                  Stroke="{StaticResource IconColor}"
                                  Fill="{StaticResource IconColor}"
                                  HeightRequest="24" WidthRequest="24"
                                  Aspect="Uniform"/>
                                <Label Text="{Binding ItineraryCount}" FontAttributes="Bold"
                                       Margin="-20,0,0,0" TranslationY="-8" TextColor="{StaticResource IconColor}"/>
                            </StackLayout>
                        </StackLayout>
                    </StackLayout>
                    <Expander Grid.Row="4" Grid.ColumnSpan="2" IsExpanded="True">
                        <Expander.Header>
                            <StackLayout Margin="0, 20, 0, 20">
                                <Label Text="Itinerary of this tour" FontSize="Medium" FontAttributes="Bold"/>
                            </StackLayout>
                        </Expander.Header>
                        <StackLayout BindableLayout.ItemsSource="{Binding Itineraries}" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="mm:ItineraryModel">
                                    <Grid ColumnDefinitions="24,Auto" RowDefinitions="24,*" >
                                        <BoxView WidthRequest="16" HeightRequest="16" CornerRadius="16" 
                                     BackgroundColor="{StaticResource IconColor}"
                                     VerticalOptions="Start" HorizontalOptions="Start"></BoxView>
                                        <BoxView WidthRequest="2"
                                     BackgroundColor="{StaticResource IconColor}"
                                     VerticalOptions="StartAndExpand"
                                     HorizontalOptions="Start"
                                     Grid.RowSpan="2" 
                                     Margin="7,2,0,0" TranslationY="14"></BoxView>
                                        <BoxView WidthRequest="24" HeightRequest="1"
                                     BackgroundColor="{StaticResource IconColor}"
                                     VerticalOptions="Start"
                                     HorizontalOptions="StartAndExpand"
                                     Margin="2,7,0,0"></BoxView>
                                        <Label Text="{Binding Title}" Grid.Column="2" VerticalOptions="StartAndExpand" 
                                   HorizontalOptions="StartAndExpand"
                                   FontAttributes="Bold" FontSize="Medium" Margin="0,-7,0,0"/>

                                        <Label Text="{Binding Description}" Grid.Column="2" Grid.Row="1" VerticalOptions="StartAndExpand" 
                                   HorizontalOptions="StartAndExpand"
                                   FontSize="Subtitle" Margin="0,-7,0,10"/>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                            
                        </StackLayout>
                    </Expander>
                </Grid>
            </Frame>

        </DataTemplate>
    </ContentPage.Resources>
    <Grid VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" BackgroundColor="#603F51B5"
          RowDefinitions="60, *">
        <StackLayout Orientation="Horizontal" Spacing="8" BackgroundColor="{StaticResource IconColor}"
                     >
            <Label Text="Recent" TextColor="White" FontSize="24" FontAttributes="Bold"
                   VerticalOptions="Center" HorizontalOptions="CenterAndExpand" HorizontalTextAlignment="Center"/>
        </StackLayout>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Items}"
                        ItemTemplate="{StaticResource PostModelTemplate}"
                        Margin="8" HorizontalOptions="FillAndExpand" VerticalOptions="StartAndExpand"
                       >
            <CollectionView.ItemsLayout>
                <LinearItemsLayout ItemSpacing="8" Orientation="Vertical" />
            </CollectionView.ItemsLayout>
        </CollectionView>
    </Grid>
</ContentPage>