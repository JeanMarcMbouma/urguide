                                </DataTrigger>
                            </Path.Triggers>
                        </Path>
                        <Label Text="{Binding Path=Likes,Mode=OneWay, Converter={StaticResource NumericToSocialUnitConverter}}" HorizontalOptions="Center" VerticalOptions="Center" />
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PostsViewModel}}, Path=LikeCommand}"
                                CommandParameter="{Binding}"
                                />
                        </StackLayout.GestureRecognizers>
                    </StackLayout>
