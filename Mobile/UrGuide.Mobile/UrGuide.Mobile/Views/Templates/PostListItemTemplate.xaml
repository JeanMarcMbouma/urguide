<?xml version="1.0" encoding="UTF-8"?>
<ContentView xmlns="http://xamarin.com/schemas/2014/forms" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="clr-namespace:UrGuide.Mobile.Models" 
             xmlns:ff="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms" 
             xmlns:shared="clr-namespace:UrGuide.Model.Shared;assembly=UrGuide.Model" 
             xmlns:st="clr-namespace:Plugin.SharedTransitions;assembly=Plugin.SharedTransitions"
             xmlns:vm="clr-namespace:UrGuide.Mobile.ViewModels"
             mc:Ignorable="d"
             x:Class="UrGuide.Mobile.Views.Templates.PostListItemTemplate"
             x:DataType="m:PostItem">
    <Frame VerticalOptions="StartAndExpand" HorizontalOptions="FillAndExpand"
                   CornerRadius="8" 
           >
            <Grid RowDefinitions="70,Auto,Auto,Auto,*" ColumnDefinitions="70,*" Margin="8,0,8,-12">

                <ff:CachedImage Source="{Binding AuthorAvatar}"
                            Aspect="AspectFit" HeightRequest="46" WidthRequest="46"
                                st:Transition.Name="AuthorAvatar"
                                st:Transition.Group="{Binding Id}">
                </ff:CachedImage>

                <StackLayout Grid.Column="1" VerticalOptions="StartAndExpand" Orientation="Vertical" Spacing="12"
                             Margin="8" st:Transition.Name="Author" st:Transition.Group="{Binding Id}">
                    <Label Text="{Binding Author}" FontSize="Medium" 
                       FontAttributes="Bold"/>
                    
                    <Label FontSize="Small">
                        <Label.Text>
                            <MultiBinding StringFormat="{}{0} {1}">
                                <Binding Path="PublicationDate"/>
                                <Binding Path="Countdown.Left"/>
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                </StackLayout>
            <Path st:Transition.Name="FavIcon" st:Transition.Group="{Binding Id}"
                        Data="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
                        Grid.Column="1"
                        HorizontalOptions="End"
                        Stroke="{StaticResource FavoriteIcon}"
                        StrokeThickness="1"
                        WidthRequest="32"
                        HeightRequest="32"
                        >
                    <Path.Triggers>
                        <DataTrigger TargetType="Path" Binding="{Binding IsBidOptIn}" Value="{Static x:Boolean.TrueString}">
                            <Setter Property="Fill" Value="{StaticResource FavoriteIcon}"/>
                        </DataTrigger>
                    </Path.Triggers>
                </Path>
                <!-- Hours-->
            <StackLayout st:Transition.Name="Hours" st:Transition.Group="{Binding Id}" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Vertical" VerticalOptions="StartAndExpand" Spacing="12">
                    <StackLayout Orientation="Horizontal" Spacing="8">
                        <Path Data="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                                  Stroke="{StaticResource IconColor}"
                                  Fill="{StaticResource IconColor}"
                                  HeightRequest="24" WidthRequest="24"
                                  Aspect="Uniform"/>
                        <Label Text="{Binding Location, StringFormat='Place: {0}'}" FontSize="Medium" FontAttributes="Bold"/>
                    </StackLayout>
                    <StackLayout Orientation="Horizontal" Spacing="8">
                        <Path Data="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"
                                  Stroke="{StaticResource IconColor}"
                                  Fill="{StaticResource IconColor}"
                                  HeightRequest="24" WidthRequest="24"
                                  Aspect="Uniform"/>
                        <Label Text="{Binding Price, StringFormat='Budget: {0}'}" FontSize="Medium" FontAttributes="Bold"/>
                    </StackLayout>
                    <StackLayout Spacing="8" Orientation="Horizontal">
                        <Path Data="M9 13.75c-2.34 0-7 1.17-7 3.5V19h14v-1.75c0-2.33-4.66-3.5-7-3.5zM4.34 17c.84-.58 2.87-1.25 4.66-1.25s3.82.67 4.66 1.25H4.34zM9 12c1.93 0 3.5-1.57 3.5-3.5S10.93 5 9 5 5.5 6.57 5.5 8.5 7.07 12 9 12zm0-5c.83 0 1.5.67 1.5 1.5S9.83 10 9 10s-1.5-.67-1.5-1.5S8.17 7 9 7zm7.04 6.81c1.16.84 1.96 1.96 1.96 3.44V19h4v-1.75c0-2.02-3.5-3.17-5.96-3.44zM15 12c1.93 0 3.5-1.57 3.5-3.5S16.93 5 15 5c-.54 0-1.04.13-1.5.35.63.89 1 1.98 1 3.15s-.37 2.26-1 3.15c.46.22.96.35 1.5.35z"
                                  Aspect="Uniform"
                                  Stroke="{StaticResource IconColor}"
                                  Fill="{StaticResource IconColor}"
                                  HeightRequest="24" WidthRequest="24"/>
                        <Label Text="{Binding Seats, StringFormat='Seats: {0}'}" FontSize="Medium" FontAttributes="Bold"/>
                    </StackLayout>
                    <Path Data="M12.5 8H11v6l4.75 2.85.75-1.23-4-2.37zm4.837-6.19l4.607 3.845-1.28 1.535-4.61-3.843zm-10.674 0l1.282 1.536L3.337 7.19l-1.28-1.536zM12 4c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9-4.03-9-9-9zm0 16c-3.86 0-7-3.14-7-7s3.14-7 7-7 7 3.14 7 7-3.14 7-7 7z"
                              Stroke="{StaticResource IconColor}"
                              Fill="{StaticResource IconColor}"
                              HeightRequest="24" WidthRequest="24"/>
                    <Grid ColumnDefinitions="10,*" RowDefinitions="Auto,*" RowSpacing="5" Margin="10,-14,0,0">
                        <BoxView Grid.RowSpan="2" HorizontalOptions="Start" VerticalOptions="StartAndExpand" 
                                     WidthRequest="2"
                                     BackgroundColor="{StaticResource IconColor}"/>
                        <BoxView HorizontalOptions="StartAndExpand"  VerticalOptions="Center" WidthRequest="8" HeightRequest="2"
                                     BackgroundColor="{StaticResource IconColor}"
                                     CornerRadius="4"/>
                        <BoxView Grid.Row="1" HorizontalOptions="StartAndExpand"  VerticalOptions="Center" WidthRequest="8" HeightRequest="2"
                                     BackgroundColor="{StaticResource IconColor}"
                                     CornerRadius="4"/>
                        <Label Grid.Column="1" FontSize="Small" FontAttributes="Bold"  >
                            <Label.FormattedText>
                                <FormattedString>
                                    <FormattedString.Spans>
                                        <Span Text="{Binding StartDate}"/>
                                        <Span Text=" "/>
                                        <Span Text="{Binding StartTime}"/>
                                    </FormattedString.Spans>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Grid.Column="1" Grid.Row="1" FontSize="Small" FontAttributes="Bold" VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <FormattedString.Spans>
                                        <Span Text="{Binding EndDate}"/>
                                        <Span Text=" "/>
                                        <Span Text="{Binding EndTime}"/>
                                    </FormattedString.Spans>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>

                </StackLayout>
                <!--Categories-->
                <StackLayout Grid.ColumnSpan="2" Grid.Row="2" VerticalOptions="StartAndExpand" 
                             Orientation="Horizontal" Spacing="8"
                             BindableLayout.ItemsSource="{Binding Categories}"
                             st:Transition.Group="{Binding Id}"
                             st:Transition.Name="Categories"
                             Margin="0,8,0,0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type x:String}">
                            <Frame CornerRadius="4" Padding="8" HasShadow="True" BackgroundColor="{StaticResource IconColor}">
                                <Label Text="{Binding}" FontSize="Small" FontAttributes="Bold" 
                                           TextColor="White"/>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </StackLayout>
                <!--Images-->
            <StackLayout Grid.Row="3" Orientation="Vertical" Grid.ColumnSpan="2"
                             VerticalOptions="StartAndExpand" Spacing="8">
                <Label Text="{Binding Description}" 
                           VerticalOptions="Start"/>
                <CollectionView ItemsSource="{Binding Images}" 
                              VerticalOptions="Start" 
                              HeightRequest="200" 
                              st:Transition.Group="{Binding Id}"
                              st:Transition.Name="PostImages"
                              >
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="shared:ImageFileModel">
                            <StackLayout>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="CurrentItem">
                                            <VisualState.Setters>
                                                <Setter Property="Scale"
                                        Value="1.1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PreviousItem">
                                            <VisualState.Setters>
                                                <Setter Property="Opacity"
                                        Value="0.5" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="NextItem">
                                            <VisualState.Setters>
                                                <Setter Property="Opacity"
                                        Value="0.5" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="DefaultItem">
                                            <VisualState.Setters>
                                                <Setter Property="Opacity"
                                        Value="0.25" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <ff:CachedImage Source="{Binding ImageBase64}" 
                                                    HeightRequest="200"
                                                    Aspect="AspectFit"
                                                    DownsampleToViewSize="True"
                                                    VerticalOptions="Start"/>
                            </StackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="4" />
                    </CollectionView.ItemsLayout>
                </CollectionView>
                <StackLayout Orientation="Horizontal" Spacing="8">
                    <!-- Likes / dislikes buttons-->
