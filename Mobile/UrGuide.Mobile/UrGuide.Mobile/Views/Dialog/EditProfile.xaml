<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:behaviors="clr-namespace:UrGuide.Mobile.Behaviors"
             xmlns:vm="clr-namespace:UrGuide.Mobile.ViewModels" xmlns:ff="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms" xmlns:y="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             mc:Ignorable="d"
             x:Class="UrGuide.Mobile.Views.Dialog.EditProfile"
             xmlns:local="clr-namespace:UrGuide.Mobile"
             x:DataType="vm:EditProfileViewModel" BackgroundColor="Transparent">
    <Grid VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" BackgroundColor="#90000000"
          >
        <RefreshView Command="{Binding LoadCommand}" IsEnabled="True" IsRefreshing="{Binding IsBusy}" >
            <Frame VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand" BackgroundColor="LightGray"
               Margin="8" CornerRadius="8">
                <Grid RowDefinitions="50, Auto, Auto" RowSpacing="12">
                    <StackLayout Orientation="Horizontal" Spacing="8">
                        <StackLayout VerticalOptions="Start" HorizontalOptions="StartAndExpand" Spacing="8" Orientation="Horizontal">
                            <Path Data="M224 256c70.7 0 128-57.3 128-128S294.7 0 224 0 96 57.3 96 128s57.3 128 128 128zm89.6 32h-16.7c-22.2 10.2-46.9 16-72.9 16s-50.6-5.8-72.9-16h-16.7C60.2 288 0 348.2 0 422.4V464c0 26.5 21.5 48 48 48h274.9c-2.4-6.8-3.4-14-2.6-21.3l6.8-60.9 1.2-11.1 7.9-7.9 77.3-77.3c-24.5-27.7-60-45.5-99.9-45.5zm45.3 145.3l-6.8 61c-1.1 10.2 7.5 18.8 17.6 17.6l60.9-6.8 137.9-137.9-71.7-71.7-137.9 137.8zM633 268.9L595.1 231c-9.3-9.3-24.5-9.3-33.8 0l-37.8 37.8-4.1 4.1 71.8 71.7 41.8-41.8c9.3-9.4 9.3-24.5 0-33.9z"
                                  Stroke="{StaticResource IconColor}" Fill="{StaticResource IconColor}"
                                  HeightRequest="24" WidthRequest="24" Aspect="Uniform" />
                            <Label Text="Edit profile" FontSize="Medium" FontAttributes="Bold"
                                   VerticalOptions="Center" HorizontalOptions="StartAndExpand"
                                   />
                        </StackLayout>
                        <StackLayout VerticalOptions="Start" HorizontalOptions="EndAndExpand" >
                            <Path Data="M256 8C119 8 8 119 8 256s111 248 248 248 248-111 248-248S393 8 256 8zm121.6 313.1c4.7 4.7 4.7 12.3 0 17L338 377.6c-4.7 4.7-12.3 4.7-17 0L256 312l-65.1 65.6c-4.7 4.7-12.3 4.7-17 0L134.4 338c-4.7-4.7-4.7-12.3 0-17l65.6-65-65.6-65.1c-4.7-4.7-4.7-12.3 0-17l39.6-39.6c4.7-4.7 12.3-4.7 17 0l65 65.7 65.1-65.6c4.7-4.7 12.3-4.7 17 0l39.6 39.6c4.7 4.7 4.7 12.3 0 17L312 256l65.6 65.1z"
                      WidthRequest="32"
                      HeightRequest="32"
                      Aspect="Uniform"
                      Stroke="{StaticResource IconColor}"
                      Fill="{StaticResource IconColor}"/>
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EditProfileViewModel}},Path=CloseDialogCommand}"/>
                            </StackLayout.GestureRecognizers>
                            <StackLayout.Behaviors>
                                <behaviors:ScaleInOutBehavior Scale="0.9"/>
                            </StackLayout.Behaviors>
                        </StackLayout>
                    </StackLayout>
                    <StackLayout Grid.Row="1" Orientation="Vertical" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                        <ff:CachedImage Source="{Binding ProfileImage}"
                                WidthRequest="124" HeightRequest="124" DownsampleToViewSize="True"
                                Aspect="AspectFit" HorizontalOptions="CenterAndExpand"/>
                        <Label Text="Upload image" HorizontalOptions="CenterAndExpand" TextDecorations="Underline"
                               TextColor="{StaticResource IconColor}" FontSize="Subtitle"/>
                    </StackLayout>
                    <ScrollView Grid.Row="2" HorizontalOptions="FillAndExpand" 
                                     VerticalOptions="FillAndExpand">
                        <StackLayout Orientation="Vertical" HorizontalOptions="FillAndExpand" 
                                     VerticalOptions="FillAndExpand" Spacing="16">
                            <StackLayout Orientation="Vertical"  HorizontalOptions="FillAndExpand">
                                <Label Text="First Name" VerticalOptions="Center" HorizontalOptions="Start" FontSize="Medium"
                                       FontAttributes="Bold" TextColor="{StaticResource IconColor}"/>
                                <Frame BorderColor="{StaticResource IconColor}" HorizontalOptions="FillAndExpand"
                                       Padding="0" CornerRadius="4" Margin="2">
                                    <Entry Text="{Binding FirstName}" Placeholder="First Name" 
                                           HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand"
                                           HeightRequest="50" Margin="0,0,0,-8" x:Name="fname" BackgroundColor="Transparent"/>
                                    <Frame.Triggers>
                                        <DataTrigger TargetType="Frame" Binding="{Binding Source={Reference fname}, Path=Text}"
                                                 Value="{x:Null}">
                                            <Setter Property="BorderColor" Value="Red"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Frame" Binding="{Binding Source={Reference fname}, Path=Text}"
                                                 Value="{x:Static x:String.Empty}">
                                            <Setter Property="BorderColor" Value="Red"/>
                                        </DataTrigger>
                                    </Frame.Triggers>
                                </Frame>
                            </StackLayout>
                            <StackLayout Orientation="Vertical"  HorizontalOptions="FillAndExpand">
                                <Label Text="Last Name" VerticalOptions="Center" HorizontalOptions="Start" FontSize="Medium"
                                       FontAttributes="Bold" TextColor="{StaticResource IconColor}"/>
                                <Frame BorderColor="{StaticResource IconColor}" HorizontalOptions="FillAndExpand"
                                       Padding="0" CornerRadius="4" Margin="2">
                                    <Entry Text="{Binding LastName}" Placeholder="Last Name" 
                                           HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand"
                                           HeightRequest="50" Margin="0,0,0,-8" x:Name="lname"/>
                                    <Frame.Triggers>
                                        <DataTrigger TargetType="Frame" Binding="{Binding Source={Reference lname}, Path=Text}"
                                                 Value="{x:Null}">
                                            <Setter Property="BorderColor" Value="Red"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Frame" Binding="{Binding Source={Reference lname}, Path=Text}"
                                                 Value="{x:Static x:String.Empty}">
                                            <Setter Property="BorderColor" Value="Red"/>
                                        </DataTrigger>
                                    </Frame.Triggers>
                                </Frame>
                            </StackLayout>

                            <StackLayout Orientation="Vertical"  HorizontalOptions="FillAndExpand" >
                                <Label Text="Country" VerticalOptions="Center" HorizontalOptions="Start" FontSize="Medium"
                                       FontAttributes="Bold" TextColor="{StaticResource IconColor}"/>
                                <Frame BorderColor="{StaticResource IconColor}" HorizontalOptions="FillAndExpand"
                                       Padding="0" CornerRadius="4" Margin="2">
                                    <Picker SelectedItem="{Binding Country}" ItemsSource="{x:Static local:Constants.Countries}"
                                           HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand"
                                           HeightRequest="50" Margin="0,0,0,-8" x:Name="country"/>
                                    <Frame.Triggers>
                                        <DataTrigger TargetType="Frame" Binding="{Binding Source={Reference country}, Path=SelectedItem}"
                                                 Value="{x:Null}">
                                            <Setter Property="BorderColor" Value="Red"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Frame" Binding="{Binding Source={Reference country}, Path=SelectedItem}"
                                                 Value="{x:Static x:String.Empty}">
                                            <Setter Property="BorderColor" Value="Red"/>
                                        </DataTrigger>
                                    </Frame.Triggers>
                                </Frame>
                            </StackLayout>

                            <StackLayout Orientation="Vertical"  HorizontalOptions="FillAndExpand" >
                                <Label Text="City" VerticalOptions="Center" HorizontalOptions="Start" FontSize="Medium"
                                       FontAttributes="Bold" TextColor="{StaticResource IconColor}"/>
                                <Frame BorderColor="{StaticResource IconColor}" HorizontalOptions="FillAndExpand"
                                       Padding="0" CornerRadius="4" Margin="2">
                                    <Entry Text="{Binding City}" Placeholder="City" 
                                           HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand"
                                           HeightRequest="50" Margin="0,0,0,-8" x:Name="city"/>
                                    <Frame.Triggers>
                                        <DataTrigger TargetType="Frame" Binding="{Binding Source={Reference city}, Path=Text}"
                                                 Value="{x:Null}">
                                            <Setter Property="BorderColor" Value="Red"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Frame" Binding="{Binding Source={Reference city}, Path=Text}"
                                                 Value="{x:Static x:String.Empty}">
                                            <Setter Property="BorderColor" Value="Red"/>
                                        </DataTrigger>
                                    </Frame.Triggers>
                                </Frame>
                            </StackLayout>

                            <StackLayout Orientation="Vertical"  HorizontalOptions="FillAndExpand" >
                                <Label Text="Address" VerticalOptions="Center" HorizontalOptions="Start" FontSize="Medium"
                                       FontAttributes="Bold" TextColor="{StaticResource IconColor}"/>
                                <Frame BorderColor="{StaticResource IconColor}" HorizontalOptions="FillAndExpand"
                                       Padding="0" CornerRadius="4" Margin="2">
                                    <Editor Text="{Binding Address}" Placeholder="Address" 
                                           HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand"
                                           HeightRequest="100" Margin="0,0,0,-8" x:Name="address"/>
                                    <Frame.Triggers>
                                        <DataTrigger TargetType="Frame" Binding="{Binding Source={Reference address}, Path=Text}"
                                                 Value="{x:Null}">
                                            <Setter Property="BorderColor" Value="Red"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Frame" Binding="{Binding Source={Reference address}, Path=Text}"
                                                 Value="{x:Static x:String.Empty}">
                                            <Setter Property="BorderColor" Value="Red"/>
                                        </DataTrigger>
                                    </Frame.Triggers>
                                </Frame>
                            </StackLayout>

                            <StackLayout Orientation="Vertical"  HorizontalOptions="FillAndExpand" >
                                <Label Text="Birth day" VerticalOptions="Center" HorizontalOptions="Start" FontSize="Medium"
                                       FontAttributes="Bold" TextColor="{StaticResource IconColor}"/>
                                <Frame BorderColor="{StaticResource IconColor}" HorizontalOptions="StartAndExpand"
                                       Padding="0" CornerRadius="4" Margin="2" WidthRequest="120">
                                    <DatePicker Date="{Binding BirthDay}" Format="dd-MMM-yyyy"
                                           HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand"
                                           HeightRequest="50" Margin="0,0,0,-8" x:Name="birth"/>
                                    <Frame.Triggers>
                                        <DataTrigger TargetType="Frame" Binding="{Binding Source={Reference birth}, Path=Date}"
                                                 Value="{x:Null}">
                                            <Setter Property="BorderColor" Value="Red"/>
                                        </DataTrigger>
                                    </Frame.Triggers>
                                </Frame>
                            </StackLayout>

                            <StackLayout Orientation="Vertical"  HorizontalOptions="FillAndExpand" >
                                <Label Text="Gender" VerticalOptions="Center" HorizontalOptions="Start" FontSize="Medium"
                                       FontAttributes="Bold" TextColor="{StaticResource IconColor}"/>
                                <Frame BorderColor="{StaticResource IconColor}" HorizontalOptions="StartAndExpand"
                                       Padding="0" CornerRadius="4" Margin="2" WidthRequest="120">
                                    <Picker SelectedItem="{Binding Gender, FallbackValue='Female'}" 
                                        VerticalOptions="CenterAndExpand" HorizontalOptions="FillAndExpand"
                                        HeightRequest="50" Margin="0,0,0,-8">
                                        <Picker.Items>
                                            <x:String>Female</x:String>
                                            <x:String>Male</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </Frame>
                            </StackLayout>
                            <StackLayout Orientation="Vertical"  HorizontalOptions="FillAndExpand" >
                                <Label Text="Description" VerticalOptions="Center" HorizontalOptions="Start" FontSize="Medium"
                                       FontAttributes="Bold" />
                                <Frame BorderColor="{StaticResource IconColor}" HorizontalOptions="FillAndExpand"
                                       Padding="0" CornerRadius="4" Margin="2">
                                    <Editor Text="{Binding Description}" Placeholder="Description" 
                                           HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand"
                                           HeightRequest="100" Margin="0,0,0,-8" x:Name="description"/>
                                    <Frame.Triggers>
                                        <DataTrigger TargetType="Frame" Binding="{Binding Source={Reference description}, Path=Text}"
                                                 Value="{x:Null}">
                                            <Setter Property="BorderColor" Value="Red"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Frame" Binding="{Binding Source={Reference description}, Path=Text}"
                                                 Value="{x:Static x:String.Empty}">
                                            <Setter Property="BorderColor" Value="Red"/>
                                        </DataTrigger>
                                    </Frame.Triggers>
                                </Frame>
                            </StackLayout>
                            <y:PancakeView CornerRadius="8" HeightRequest="40" WidthRequest="90" 
                                       HorizontalOptions="EndAndExpand"
                                               VerticalOptions="CenterAndExpand"
                                               BackgroundColor="{StaticResource IconColor}">
                                <Label Text="Save" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"
                                           FontSize="Medium" TextColor="White" FontAttributes="Bold"/>
                                <y:PancakeView.GestureRecognizers>
                                    <TapGestureRecognizer NumberOfTapsRequired="1"
                                                              Command="{Binding SaveCommand}"
                                                              />
                                </y:PancakeView.GestureRecognizers>
                            </y:PancakeView>
                        </StackLayout>
                    </ScrollView>
                </Grid>
            </Frame>
        </RefreshView>
    </Grid>
</ContentPage>