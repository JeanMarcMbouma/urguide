<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="UrGuide.Mobile.Views.Dialog.BidDialog"
             xmlns:icons="clr-namespace:UrGuide.Mobile.Helpers"
             xmlns:vm="clr-namespace:UrGuide.Mobile.ViewModels" xmlns:behaviors="clr-namespace:UrGuide.Mobile.Behaviors" xmlns:models="clr-namespace:UrGuide.Model.Posts;assembly=UrGuide.Model" xmlns:ff="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms" xmlns:y="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             Title="Bids"
             x:DataType="vm:BidDialogViewModel" BackgroundColor="Transparent">
    <Grid VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" BackgroundColor="#90000000"
          >
        <RefreshView Command="{Binding LoadBidCommand}" IsEnabled="True" IsRefreshing="{Binding IsBusy}" >
            <Frame VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" BackgroundColor="LightGray"
               Margin="8" CornerRadius="8">
            <CollectionView ItemsSource="{Binding Items}" ItemSizingStrategy="MeasureAllItems"
                        Header="Bid history" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand"
                        Margin="-4,-8,-4,-4"
                        Footer="Your bid"
                        >
            <CollectionView.ItemsLayout>
                <GridItemsLayout HorizontalItemSpacing="20" Orientation="Vertical" Span="{OnIdiom Phone=1,Tablet=2}"
                                 VerticalItemSpacing="8"/>
            </CollectionView.ItemsLayout>
            <CollectionView.HeaderTemplate>
                <DataTemplate>
                    <StackLayout Orientation="Horizontal" Spacing="8">
                            <Path Data="M 504.971 199.362 l -22.627 -22.627 c -9.373 -9.373 -24.569 -9.373 -33.941 0 l -5.657 5.657 L 329.608 69.255 l 5.657 -5.657 c 9.373 -9.373 9.373 -24.569 0 -33.941 L 312.638 7.029 c -9.373 -9.373 -24.569 -9.373 -33.941 0 L 154.246 131.48 c -9.373 9.373 -9.373 24.569 0 33.941 l 22.627 22.627 c 9.373 9.373 24.569 9.373 33.941 0 l 5.657 -5.657 l 39.598 39.598 l -81.04 81.04 l -5.657 -5.657 c -12.497 -12.497 -32.758 -12.497 -45.255 0 L 9.373 412.118 c -12.497 12.497 -12.497 32.758 0 45.255 l 45.255 45.255 c 12.497 12.497 32.758 12.497 45.255 0 l 114.745 -114.745 c 12.497 -12.497 12.497 -32.758 0 -45.255 l -5.657 -5.657 l 81.04 -81.04 l 39.598 39.598 l -5.657 5.657 c -9.373 9.373 -9.373 24.569 0 33.941 l 22.627 22.627 c 9.373 9.373 24.569 9.373 33.941 0 l 124.451 -124.451 c 9.372 -9.372 9.372 -24.568 0 -33.941 Z"
                              Stroke="{StaticResource IconColor}" Fill="{StaticResource IconColor}"
                              HeightRequest="24" WidthRequest="24" Aspect="Uniform" />
                            <Label Text="{Binding Source={RelativeSource AncestorType={x:Type vm:BidDialogViewModel}}, Path=Item.Text, StringFormat=' - {0}'}" FontSize="Medium" FontAttributes="Bold"
                               VerticalOptions="Center" HorizontalOptions="StartAndExpand"
                               />
                        <StackLayout VerticalOptions="Start" HorizontalOptions="EndAndExpand" >
                                    <Image Source="{FontImage FontFamily=fas, 
                        Glyph={x:Static icons:FAI.TimesCircle}, 
                        Color={StaticResource IconColor},Size=24}" WidthRequest="24"/>
                                    <StackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BidDialogViewModel}},Path=CloseDialogCommand}"/>
                            </StackLayout.GestureRecognizers>
                            <StackLayout.Behaviors>
                                <behaviors:ScaleInOutBehavior Scale="0.9"/>
                            </StackLayout.Behaviors>
                        </StackLayout>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.HeaderTemplate>
            <CollectionView.EmptyViewTemplate>
                <DataTemplate>
                    <StackLayout Orientation="Horizontal" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">
                        <Label Text="Nothing here"/>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.EmptyViewTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:BidHistoryModel">
                        <SwipeView BackgroundColor="Transparent" x:Name="swipe">
                            <SwipeView.RightItems>
                                <SwipeItem IsVisible="{Binding IsActive}" Text="Accept" BackgroundColor="{StaticResource FavoriteIcon}"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BidDialogViewModel}}, Path=AcceptBidCommand}"
                                           />
                            </SwipeView.RightItems>
                            <SwipeView.LeftItems>
                                <SwipeItem IsVisible="{Binding IsActive}" Text="Reject" BackgroundColor="Red"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BidDialogViewModel}}, Path=RejectBidCommand}"
                                           >
                                    
                                </SwipeItem>
                            </SwipeView.LeftItems>
                            <Frame CornerRadius="2" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"
                               BackgroundColor="#fff">
                                <StackLayout Orientation="Horizontal" Spacing="12">
                                    <ff:CachedImage Source="{Binding AuthorImage}"
                                            HeightRequest="64"
                                            WidthRequest="64"
                                            Aspect="AspectFit"
                                            Margin="4"
                                            VerticalOptions="Start"
                                            HorizontalOptions="Start"></ff:CachedImage>
                                    <Grid ColumnDefinitions="*, 70" HorizontalOptions="FillAndExpand">
                                        <StackLayout Orientation="Vertical" Margin="8">
                                            <Label Text="{Binding Author}" FontSize="Medium" FontAttributes="Bold"
                                       HorizontalOptions="Start" VerticalOptions="Center"/>
                                            <Label Text="{Binding Created}" FontSize="Small" HorizontalOptions="StartAndExpand"
                                       VerticalOptions="CenterAndExpand"/>
                                        </StackLayout>
                                        <Label Text="{Binding Value}" Grid.Column="1" FontSize="Title"
                                       VerticalOptions="Center" HorizontalOptions="EndAndExpand"
                                       FontAttributes="Bold"
                                       />
                                    </Grid>
                                </StackLayout>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.FooterTemplate>
                    <DataTemplate>
                        <Frame CornerRadius="2" BackgroundColor="#fff" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                            <StackLayout Orientation="Horizontal" Spacing="8">
                                <Label VerticalOptions="CenterAndExpand"
                                       HorizontalOptions="StartAndExpand" FontSize="Medium" FontAttributes="Bold">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}${0:#}">
                                            <Binding Source="{Reference newBid}" Path="Value" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                                <Slider VerticalOptions="CenterAndExpand" Maximum="250" 
                                        MinimumTrackColor="{StaticResource FavoriteIcon}"
                                      MaximumTrackColor="{StaticResource IconColor}" Value="25" x:Name="newBid"
                                        HorizontalOptions="StartAndExpand" WidthRequest="170"/>
                                <y:PancakeView CornerRadius="8" HeightRequest="40" WidthRequest="90" HorizontalOptions="EndAndExpand"
                                               VerticalOptions="CenterAndExpand"
                                               BackgroundColor="{StaticResource IconColor}">
                                    <Label Text="Bid" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand"
                                           FontSize="Medium" TextColor="White" FontAttributes="Bold"/>
                                    <y:PancakeView.GestureRecognizers>
                                        <TapGestureRecognizer NumberOfTapsRequired="1"
                                                              Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BidDialogViewModel}}, Path=NewBidCommand}"
                                                              CommandParameter="{Binding Source={Reference newBid}, Path=Value}"/>
                                    </y:PancakeView.GestureRecognizers>
                                </y:PancakeView>
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.FooterTemplate>
        </CollectionView>

        </Frame>
        </RefreshView>
    </Grid>
</ContentPage>