<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:tt="clr-namespace:UrGuide.Mobile.Views.Templates"
             xmlns:vm="clr-namespace:UrGuide.Mobile.ViewModels" xmlns:controls="clr-namespace:UrGuide.Mobile.Views.Controls"
             mc:Ignorable="d"
             x:Class="UrGuide.Mobile.Views.PostDetailPage" x:DataType="vm:PostDetailViewModel" 
             Title="{Binding Selected.Text}"
             x:Name="details"
             >
    
    <Grid VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
        <RefreshView IsRefreshing="{Binding LoadSelectedItem.ShowRefresher}" Command="{Binding LoadSelectedItem.RefreshCommand}">
            <ScrollView>
                <StackLayout Orientation="Vertical">
                    <tt:PostDetailTemplate BindingContext="{Binding Selected}">
                        <tt:PostDetailTemplate.Triggers>
                            <DataTrigger TargetType="tt:PostDetailTemplate" Binding="{Binding Source={Reference details}, Path=BindingContext.LoadSelectedItem.ShowRefresher}"
                                     Value="{x:Static x:Boolean.TrueString}">
                                <Setter Property="IsVisible" Value="False"/>
                            </DataTrigger>
                        </tt:PostDetailTemplate.Triggers>
                    </tt:PostDetailTemplate>
                    <StackLayout Orientation="Vertical" IsVisible="False" Margin="16,16">
                        <StackLayout.Triggers>
                            <DataTrigger TargetType="StackLayout"
                                         Binding="{Binding CanReview}" Value="True">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </StackLayout.Triggers>
                        <Label Text="Write a review" Style="{StaticResource TextHeader}" HorizontalTextAlignment="Start" FontSize="Medium" FontAttributes="Bold"/>
                        <controls:Rating Minimum="1" Maximum="5" Value="{Binding Path=NewFeedbackRating}"/>
                        <Frame Margin="0,10" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand"
                                   HeightRequest="200" CornerRadius="4" BorderColor="{StaticResource IconColor}"
                                   Padding="0">

                            <Editor HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"
                                       Margin="0,0,0,-8" Text="{Binding Path=NewFeedbackText}"
                                   />
                        </Frame>
                        <Button Text="Submit"
                                    BackgroundColor="{StaticResource FavoriteIcon}"
                                    VerticalOptions="EndAndExpand"
                                    HorizontalOptions="FillAndExpand" CornerRadius="8"
                                    HeightRequest="40"
                                Visual="Material"
                            TextColor="White"
                                Command="{Binding Path=NewFeedBackCommand}"
                                >
                        </Button>
                    </StackLayout>
                </StackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>