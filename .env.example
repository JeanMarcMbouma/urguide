# Environment variables for Docker Compose
# Copy this file to .env and update with your values
# SECURITY: Never commit the actual .env file with real secrets!

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# SQL Server SA Password
# IMPORTANT: Change this to a strong password in production
# Requirements: At least 8 characters, include uppercase, lowercase, numbers, and special characters
SQL_SA_PASSWORD=YourStrong@Passw0rd

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development

# Optional: Override default connection strings
# ConnectionStrings__DefaultConnection=Server=sqlserver;Database=urguide_data;User Id=sa;Password=${SQL_SA_PASSWORD};TrustServerCertificate=True;MultipleActiveResultSets=true
# ConnectionStrings__AuthConnection=Server=sqlserver;Database=urguide_id4;User Id=sa;Password=${SQL_SA_PASSWORD};TrustServerCertificate=True;MultipleActiveResultSets=true

# =============================================================================
# EXTERNAL API KEYS
# =============================================================================

# IPStack API Key - for IP geolocation services
# Get your key from: https://ipstack.com/
IPSTACK_API_KEY=your-ipstack-api-key-here

# SendGrid API Key - for email notifications
# Get your key from: https://sendgrid.com/
SENDGRID_API_KEY=your-sendgrid-api-key-here

# Stripe Payment Gateway Keys
# Get your keys from: https://dashboard.stripe.com/apikeys
# SECURITY: Never commit real keys to source control!
STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here
STRIPE_SECRET_KEY=sk_test_your-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# =============================================================================
# IDENTITY SERVER / OAUTH CONFIGURATION
# =============================================================================

# Client Secret for Xamarin mobile app authentication
# Generate a secure random string (at least 32 characters recommended)
# You can generate one with: openssl rand -base64 32
XAMARIN_CLIENT_SECRET=your-secure-client-secret-here

# Admin Dashboard Client Secret (for IdentityServer authentication)
# Generate a secure random string (at least 32 characters recommended)
# SECURITY: Never commit this to source control!
ADMIN_DASHBOARD_CLIENT_SECRET=your-secure-admin-dashboard-secret-here

# Application URI (adjust for your deployment)
APPLICATION_URI=http://localhost:5000

# JWT Secret Key (for custom JWT token generation)
# SECURITY: Generate a strong random key for production!
# You can generate one with: openssl rand -base64 32
# DO NOT COMMIT this value in Git! Use User Secrets locally or Azure Key Vault in production
# If not set, a development key will be auto-generated (insecure for production)
JWT__KEY=your-secure-random-jwt-key-here

# JWT Token Expiration (in hours, default is 8 hours)
JWT__EXPIRESINHOUHS=8

# =============================================================================
# ADMIN USER PROVISIONING
# =============================================================================

# Enable automatic admin user provisioning on startup
# Set to true for development, false for production
SEED_ADMIN_ENABLED=true

# Default admin user credentials
# SECURITY: Change these values in production!
# Requirements: Password must be at least 6 characters with uppercase, lowercase, and numbers
ADMIN_EMAIL=admin@urguide.local
ADMIN_PASSWORD=Admin123!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# =============================================================================
# MESSAGE QUEUE CONFIGURATION
# =============================================================================

# RabbitMQ Credentials
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# =============================================================================
# ELASTICSEARCH CONFIGURATION (Optional)
# =============================================================================

# Elasticsearch Credentials (if authentication is enabled)
# Leave empty if Elasticsearch doesn't require authentication
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# =============================================================================
# AZURE SERVICES (Optional)
# =============================================================================

# Azure Key Vault URL (for production secret management)
# KEYVAULT_URL=https://your-keyvault.vault.azure.net/

# Azure SignalR Connection String (if using Azure SignalR instead of self-hosted)
# AZURE_SIGNALR_CONNECTION_STRING=Endpoint=https://your-signalr.service.signalr.net;AccessKey=your-key;Version=1.0;
