# UrGuide Docker Compose - .env Configuration Example
# This file shows a complete .env configuration for Docker Compose deployment
# Copy this to .env and customize for your environment

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

SQL_SA_PASSWORD=DevStrong@Pass2026
ASPNETCORE_ENVIRONMENT=Development

# =============================================================================
# ADMIN USER AUTO-PROVISIONING
# =============================================================================
# These credentials are used to create the initial admin user on first startup

# Enable admin provisioning (set to false after initial setup in production)
SEED_ADMIN_ENABLED=true

# Admin user credentials
ADMIN_EMAIL=admin@urguide.local
ADMIN_PASSWORD=Admin123!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# =============================================================================
# MESSAGE QUEUE
# =============================================================================

RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# =============================================================================
# EXTERNAL API KEYS
# =============================================================================

IPSTACK_API_KEY=your-ipstack-api-key-here
SENDGRID_API_KEY=your-sendgrid-api-key-here
XAMARIN_CLIENT_SECRET=your-secure-client-secret-here

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

APPLICATION_URI=http://localhost:5000

# =============================================================================
# QUICK START INSTRUCTIONS
# =============================================================================
# 
# 1. Copy this file:
#    cp .env.example.complete .env
#
# 2. Edit admin credentials (change ADMIN_EMAIL and ADMIN_PASSWORD)
#
# 3. Add your API keys (IPSTACK_API_KEY, SENDGRID_API_KEY)
#
# 4. Start Docker Compose:
#    docker-compose up -d
#
# 5. Verify admin user creation:
#    docker-compose logs api | grep "admin user"
#
# 6. Login to admin dashboard:
#    URL: http://localhost:3001
#    Email: Value from ADMIN_EMAIL above
#    Password: Value from ADMIN_PASSWORD above
#
# 7. IMPORTANT: Change the admin password after first login!
#
# =============================================================================
# SECURITY NOTES
# =============================================================================
#
# ⚠️  DEVELOPMENT:
#     - Default credentials are fine for local development
#     - .env file is git-ignored (safe to store locally)
#
# ⚠️  PRODUCTION:
#     - Use strong, unique passwords (12+ chars, mixed case, numbers, symbols)
#     - Set SEED_ADMIN_ENABLED=false after initial deployment
#     - Store .env securely (not in source control)
#     - Change admin password immediately after first login
#     - Consider using Azure Key Vault or AWS Secrets Manager
#
# =============================================================================
