<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:UrGuide.MAUI.Views"
       x:Class="UrGuide.MAUI.AppShell"
       Title="UrGuide">

    <ShellContent
        Title="Discover"
        ContentTemplate="{DataTemplate local:DiscoverPage}"
        Route="DiscoverPage" 
        Icon="discover.png" />

    <ShellContent
        Title="Posts"
        ContentTemplate="{DataTemplate local:PostsPage}"
        Route="PostsPage"
        Icon="posts.png" />

    <ShellContent
        Title="Favorites"
        ContentTemplate="{DataTemplate local:FavoritePage}"
        Route="FavoritePage"
        Icon="favorite.png" />

    <ShellContent
        Title="Profile"
        ContentTemplate="{DataTemplate local:ProfilePage}"
        Route="ProfilePage"
        Icon="profile.png" />

</Shell>