<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="UrGuide.MAUI.Views.UpdateBudgetPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:UrGuide.MAUI.ViewModels"
             x:DataType="viewmodels:UpdateBudgetViewModel"
             Title="Update Budget">

    <StackLayout Padding="16" Spacing="24">

        <!-- Current Budget Info -->
        <Frame BackgroundColor="#E3F2FD" Padding="16" CornerRadius="8">
            <StackLayout>
                <Label Text="Current Budget" 
                       FontSize="14" 
                       FontAttributes="Bold"
                       TextColor="#1976D2" />
                <Label Text="{Binding CurrentBudget, StringFormat='${0:F2}'}" 
                       FontSize="24" 
                       FontAttributes="Bold"
                       TextColor="#1976D2" />
            </StackLayout>
        </Frame>

        <!-- Instructions -->
        <StackLayout>
            <Label Text="💡 Budget Update Guidelines" 
                   FontSize="16" 
                   FontAttributes="Bold"
                   Margin="0,0,0,8" />
            <Label Text="• The new budget must be higher than your current budget" 
                   FontSize="14"
                   TextColor="Gray" />
            <Label Text="• Guides in your region will be notified about the budget increase" 
                   FontSize="14"
                   TextColor="Gray" />
            <Label Text="• This may attract more guide proposals for your tour request" 
                   FontSize="14"
                   TextColor="Gray" />
        </StackLayout>

        <!-- New Budget Input -->
        <StackLayout>
            <Label Text="New Budget" FontAttributes="Bold" FontSize="16" />
            <Entry x:Name="NewBudgetEntry" 
                   Text="{Binding NewBudget}" 
                   Keyboard="Numeric"
                   Placeholder="Enter new budget amount"
                   FontSize="18"
                   BackgroundColor="White" />
            <Label Text="{Binding NewBudget, StringFormat='New budget: ${0:F2}'}" 
                   FontSize="14"
                   TextColor="#4CAF50"
                   FontAttributes="Bold"
                   IsVisible="{Binding NewBudget, Converter={StaticResource IsGreaterThanZeroConverter}}" />
        </StackLayout>

        <!-- Budget Difference -->
        <StackLayout IsVisible="{Binding NewBudget, Converter={StaticResource IsGreaterThanZeroConverter}}">
            <Label Text="{Binding ., StringFormat='Increase: +${0:F2}', Converter={StaticResource BudgetDifferenceConverter}}" 
                   FontSize="14"
                   TextColor="#FF9800"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />
        </StackLayout>

        <!-- Error Message -->
        <Label Text="{Binding ErrorMessage}" 
               TextColor="Red" 
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}" />

        <!-- Update Button -->
        <Button Text="Update Budget" 
                Command="{Binding UpdateBudgetCommand}"
                IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                BackgroundColor="#4CAF50"
                TextColor="White"
                HeightRequest="50"
                FontSize="16"
                FontAttributes="Bold" />

        <!-- Loading Indicator -->
        <ActivityIndicator IsRunning="{Binding IsLoading}" 
                          IsVisible="{Binding IsLoading}"
                          Color="#4CAF50" />

        <!-- Cancel Button -->
        <Button Text="Cancel" 
                Clicked="OnCancelClicked"
                BackgroundColor="Transparent"
                TextColor="Gray"
                BorderColor="Gray"
                BorderWidth="1"
                HeightRequest="45" />

    </StackLayout>

</ContentPage>