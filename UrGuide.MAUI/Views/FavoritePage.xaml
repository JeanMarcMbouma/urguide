<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UrGuide.MAUI.Views.FavoritePage"
             Title="Favorites"
             x:DataType="vm:FavoriteViewModel"
             xmlns:vm="clr-namespace:UrGuide.MAUI.ViewModels"
             xmlns:models="clr-namespace:UrGuide.MAUI.Models">
             x:DataType="vm:FavoriteViewModel"
             xmlns:vm="clr-namespace:UrGuide.MAUI.ViewModels">

    <Grid>
        <!-- Favorites List -->
        <CollectionView ItemsSource="{Binding Favorites}"
                        SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PostItem">
                    <Grid Padding="15,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0"
                               Text="{Binding Title}"
                               Style="{StaticResource TextTitle}"
                               MaxLines="2" />

                        <Label Grid.Row="1"
                               Text="{Binding Description}"
                               Style="{StaticResource TextBody}"
                               MaxLines="3"
                               Margin="0,5,0,0" />

                        <StackLayout Grid.Row="2"
                                     Orientation="Horizontal"
                                     Margin="0,10,0,0">
                            <Label Text="{Binding Price, StringFormat='${0}'}"
                                   Style="{StaticResource TextTitle}"
                                   TextColor="{StaticResource Primary}" />
                            <Button Text="♥"
                                    TextColor="{StaticResource Red}"
                                    BackgroundColor="Transparent"
                                    FontSize="18"
                                    HorizontalOptions="EndAndExpand"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FavoriteViewModel}}, Path=RemoveFavoriteCommand}"
                                    CommandParameter="{Binding .}" />
                        </StackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Empty State -->
        <StackLayout IsVisible="{Binding HasNoFavorites}"
                     VerticalOptions="Center"
                     HorizontalOptions="Center">
            <Label Text="♥"
                   FontSize="48"
                   TextColor="{StaticResource Gray300}"
                   HorizontalOptions="Center" />
            <Label Text="No favorites yet"
                   Style="{StaticResource TextTitle}"
                   HorizontalOptions="Center"
                   Margin="0,10,0,0" />
            <Label Text="Add tours to your favorites to see them here"
                   Style="{StaticResource TextBody}"
                   HorizontalOptions="Center"
                   Margin="0,5,0,0" />
        </StackLayout>

        <!-- Loading Indicator -->
        <ActivityIndicator IsVisible="{Binding IsLoading}"
                           IsRunning="{Binding IsLoading}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />

    </Grid>
</ContentPage>