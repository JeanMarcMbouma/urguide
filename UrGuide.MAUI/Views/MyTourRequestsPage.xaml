<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="UrGuide.MAUI.Views.MyTourRequestsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:UrGuide.MAUI.ViewModels"
             xmlns:models="clr-namespace:UrGuide.MAUI.Models"
             x:DataType="viewmodels:MyTourRequestsViewModel"
             Title="My Tour Requests">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with Create Button -->
        <StackLayout Grid.Row="0" Orientation="Horizontal" Padding="16,8" BackgroundColor="#F5F5F5">
            <Label Text="My Tour Requests" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center"
                   HorizontalOptions="StartAndExpand" />
            <Button Text="+" 
                    Command="{Binding CreateNewRequestCommand}"
                    WidthRequest="40"
                    HeightRequest="40"
                    BackgroundColor="#007ACC"
                    TextColor="White"
                    CornerRadius="20" />
        </StackLayout>

        <!-- Main Content -->
        <StackLayout Grid.Row="1" Padding="16">

            <!-- Error Message -->
            <Label Text="{Binding ErrorMessage}" 
                   TextColor="Red" 
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}" />

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                              IsVisible="{Binding IsLoading}"
                              Color="#007ACC"
                              VerticalOptions="CenterAndExpand" />

            <!-- No Tour Requests Message -->
            <StackLayout IsVisible="{Binding HasNoTourRequests}" 
                        VerticalOptions="CenterAndExpand"
                        HorizontalOptions="Center">
                <Label Text="📋" 
                       FontSize="48"
                       HorizontalOptions="Center" />
                <Label Text="No tour requests yet" 
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
                <Label Text="Create your first tour request to connect with local guides" 
                       FontSize="14"
                       TextColor="Gray"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
                <Button Text="Create Tour Request" 
                        Command="{Binding CreateNewRequestCommand}"
                        BackgroundColor="#007ACC"
                        TextColor="White"
                        Margin="0,16,0,0" />
            </StackLayout>

            <!-- Tour Requests List -->
            <CollectionView ItemsSource="{Binding TourRequests}"
                           IsVisible="{Binding HasNoTourRequests, Converter={StaticResource InvertedBoolConverter}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TourRequestItem">
                        <Grid Padding="0,8">
                            <Frame BackgroundColor="White" 
                                   HasShadow="True"
                                   Padding="16"
                                   CornerRadius="8">
                                <StackLayout>
                                    <!-- Header -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <Label Grid.Column="0"
                                               Text="{Binding Title}" 
                                               FontSize="16" 
                                               FontAttributes="Bold" />
                                        
                                        <Label Grid.Column="1"
                                               Text="{Binding Status}" 
                                               FontSize="12"
                                               BackgroundColor="#E3F2FD"
                                               TextColor="#1976D2"
                                               Padding="8,4"
                                               VerticalOptions="Start" />
                                    </Grid>

                                    <!-- Description -->
                                    <Label Text="{Binding Description}" 
                                           FontSize="14"
                                           TextColor="Gray"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation" />

                                    <!-- Details -->
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackLayout Grid.Column="0">
                                            <Label Text="Date" FontSize="12" TextColor="Gray" />
                                            <Label Text="{Binding FormattedDate}" FontSize="14" FontAttributes="Bold" />
                                        </StackLayout>

                                        <StackLayout Grid.Column="1">
                                            <Label Text="Budget" FontSize="12" TextColor="Gray" />
                                            <Label Text="{Binding FormattedBudget}" FontSize="14" FontAttributes="Bold" TextColor="#4CAF50" />
                                        </StackLayout>
                                    </Grid>

                                    <!-- Region and Participants -->
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackLayout Grid.Column="0">
                                            <Label Text="{Binding RegionName}" FontSize="12" TextColor="Gray" />
                                        </StackLayout>

                                        <Label Grid.Column="1"
                                               Text="{Binding MaxParticipants, StringFormat='Max {0} people'}" 
                                               FontSize="12" 
                                               TextColor="Gray" />
                                    </Grid>

                                    <!-- Action Buttons -->
                                    <StackLayout Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                                        <Button Text="Update Budget" 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MyTourRequestsViewModel}}, Path=UpdateBudgetCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding CanUpdateBudget}"
                                                BackgroundColor="#FF9800"
                                                TextColor="White"
                                                FontSize="12"
                                                HeightRequest="36"
                                                HorizontalOptions="FillAndExpand" />
                                        
                                        <Button Text="Cancel" 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MyTourRequestsViewModel}}, Path=CancelRequestCommand}"
                                                CommandParameter="{Binding .}"
                                                IsVisible="{Binding CanCancel}"
                                                BackgroundColor="#F44336"
                                                TextColor="White"
                                                FontSize="12"
                                                HeightRequest="36"
                                                HorizontalOptions="FillAndExpand" />
                                    </StackLayout>

                                </StackLayout>
                            </Frame>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </StackLayout>
    </Grid>

</ContentPage>