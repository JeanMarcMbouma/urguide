<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UrGuide.MAUI.Views.DiscoverPage"
             Title="Discover"
             x:DataType="vm:DiscoverViewModel"
             xmlns:vm="clr-namespace:UrGuide.MAUI.ViewModels"
             xmlns:models="clr-namespace:UrGuide.MAUI.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search Bar -->
        <SearchBar Grid.Row="0"
                   Placeholder="Search tours..."
                   Margin="15,20,15,10"
                   BackgroundColor="{StaticResource LightSurface}"
                   Text="{Binding SearchText}"
                   SearchCommand="{Binding SearchCommand}" />

        <!-- Posts List -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Posts}"
                        SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DiscoverItem">
                    <Grid Padding="15,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0"
                               Text="{Binding Title}"
                               Style="{StaticResource TextTitle}"
                               MaxLines="2" />

                        <Label Grid.Row="1"
                               Text="{Binding Description}"
                               Style="{StaticResource TextBody}"
                               MaxLines="3"
                               Margin="0,5,0,0" />

                        <StackLayout Grid.Row="2"
                                     Orientation="Horizontal"
                                     Margin="0,10,0,0">
                            <Label Text="{Binding Price, StringFormat='${0}'}"
                                   Style="{StaticResource TextTitle}"
                                   TextColor="{StaticResource Primary}" />
                            <Label Text="{Binding Location}"
                                   Style="{StaticResource TextBody}"
                                   HorizontalOptions="EndAndExpand" />
                        </StackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="1"
                           IsVisible="{Binding IsLoading}"
                           IsRunning="{Binding IsLoading}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />

    </Grid>
</ContentPage>