{
  "_comment": "This is an example User Secrets configuration file for UrGuide.",
  "_comment2": "DO NOT commit this file to Git if you add real values!",
  "_comment3": "To use these secrets in development:",
  "_comment4": "1. Navigate to UrGuide.WebApp directory",
  "_comment5": "2. Run: dotnet user-secrets set 'IpStack:ApiKey' 'your-actual-key'",
  "_comment6": "3. Or import this entire file: cat secrets.json | dotnet user-secrets set",
  "_comment7": "See SECRETS_MANAGEMENT.md for full documentation",
  
  "IpStack": {
    "ApiKey": "your-ipstack-api-key-here"
  },
  "SENDGRID_URGUIDE_API_KEY": "your-sendgrid-api-key-here",
  "IdentityServer": {
    "Clients": {
      "Xamarin": {
        "ClientSecret": "your-secure-random-client-secret-here"
      }
    }
  },
  "ConnectionStrings": {
    "Data": "Server=localhost;Database=urguide_data;User Id=sa;Password=YourPassword;TrustServerCertificate=True;",
    "Id4": "Server=localhost;Database=urguide_id4;User Id=sa;Password=YourPassword;TrustServerCertificate=True;"
  }
}
