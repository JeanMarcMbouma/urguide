{
  "Xamarin": "urguide://callback",
  "ConnectionStrings": {
    "Id4": "Server=(localdb)\\mssqllocaldb;Database=urguide_id4;Trusted_Connection=True;MultipleActiveResultSets=true",
    "Data": "Server=(localdb)\\mssqllocaldb;Database=urguide_data;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "IdentityServer": {
    "Clients": {
      "UrGuide.WebApp": {
        "Profile": "IdentityServerSPA"
      },
      "Xamarin": {
        "ClientSecret": ""
      }
    },
    "ApplicationUri": "https://urguides.azurewebsites.net",
    "Key": {
      "Type": "Development"
    }
  },
  "AllowedHosts": "*",
  "RabbitMQ": {
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },
  "MessageQueue": {
    "UseQueuedServices": false,
    "EnableMonitoring": true
  },
  "IpRateLimitPolicies": {
    "EnableEndpointRateLimiting": false,
    "StackBlockedRequests": false,
    "IpRules": [
      {
        "Ip": "*",
        "Rules": [
          {
            "Endpoint": "*",
            "Period": "1s",
            "Limit": 10
          }
        ]
      }
    ]
  },
  "IpStack": {
    "Url": "http://api.ipstack.com/",
    "ApiKey": ""
  },
  "SENDGRID_URGUIDE_API_KEY": "",
  "_comment_secrets": "SECURITY: Never store actual API keys here. Use User Secrets for local development (dotnet user-secrets set 'IpStack:ApiKey' 'your-key') or Azure Key Vault for production. See SECRETS_MANAGEMENT.md for details.",
  "Stripe": {
    "PublishableKey": "",
    "SecretKey": "",
    "WebhookSecret": "",
    "_comment": "SECURITY: Store actual Stripe keys in User Secrets (dotnet user-secrets set 'Stripe:SecretKey' 'sk_test_...'). Never commit real API keys to source control."
  },
  "Azure": {
    "SignalR": {
      "Enabled": "true"
    }
  },
  "TieredRateLimit": {
    "Enabled": true,
    "EnableAnalytics": true,
    "Policies": {
      "Anonymous": {
        "Tier": "Anonymous",
        "Limit": 10,
        "Period": "1m"
      },
      "Authenticated": {
        "Tier": "Authenticated",
        "Limit": 60,
        "Period": "1m"
      },
      "Premium": {
        "Tier": "Premium",
        "Limit": 300,
        "Period": "1m"
      }
    },
    "EndpointPolicies": {
      "POST:/tour-requests": {
        "Anonymous": {
          "Tier": "Anonymous",
          "Limit": 2,
          "Period": "1h"
        },
        "Authenticated": {
          "Tier": "Authenticated",
          "Limit": 10,
          "Period": "1h"
        },
        "Premium": {
          "Tier": "Premium",
          "Limit": 50,
          "Period": "1h"
        }
      },
      "POST:/payments": {
        "Anonymous": {
          "Tier": "Anonymous",
          "Limit": 1,
          "Period": "1h"
        },
        "Authenticated": {
          "Tier": "Authenticated",
          "Limit": 5,
          "Period": "1h"
        },
        "Premium": {
          "Tier": "Premium",
          "Limit": 20,
          "Period": "1h"
        }
      }
    },
    "Exemptions": [
      "127.0.0.1",
      "::1"
    ]
  }
}