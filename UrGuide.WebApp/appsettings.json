{
  "Xamarin": "urguide://callback",
  "ConnectionStrings": {
    "Id4": "Server=(localdb)\\mssqllocaldb;Database=urguide_id4;Trusted_Connection=True;MultipleActiveResultSets=true",
    "Data": "Server=(localdb)\\mssqllocaldb;Database=urguide_data;Trusted_Connection=True;MultipleActiveResultSets=true",
    "_comment": "DOCKER: These are overridden by environment variables in docker-compose.yml. LocalDB is for Windows development only."
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "IdentityServer": {
    "Clients": {
      "UrGuide.WebApp": {
        "Profile": "IdentityServerSPA"
      },
      "Xamarin": {
        "ClientSecret": "",
        "_comment": "Set via XAMARIN_CLIENT_SECRET environment variable"
      },
      "AdminDashboard": {
        "ClientId": "admin-dashboard",
        "ClientSecret": "",
        "_comment": "REQUIRED: Set via ADMIN_DASHBOARD_CLIENT_SECRET environment variable"
      }
    },
    "ApplicationUri": "https://urguides.azurewebsites.net",
    "Key": {
      "Type": "Development"
    }
  },
  "AllowedHosts": "*",
  "RabbitMQ": {
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "",
    "_comment": "DOCKER: Username/Password are overridden by RABBITMQ_USER and RABBITMQ_PASS environment variables."
  },
  "MessageQueue": {
    "UseQueuedServices": false,
    "EnableMonitoring": true
  },
  "Elasticsearch": {
    "Url": "http://localhost:9200",
    "DefaultIndex": "urguide",
    "Username": "",
    "Password": "",
    "_comment": "SECURITY: If authentication is required, set via ELASTICSEARCH_USERNAME and ELASTICSEARCH_PASSWORD environment variables."
  },
  "IpRateLimitPolicies": {
    "EnableEndpointRateLimiting": false,
    "StackBlockedRequests": false,
    "IpRules": [
      {
        "Ip": "*",
        "Rules": [
          {
            "Endpoint": "*",
            "Period": "1s",
            "Limit": 10
          }
        ]
      }
    ]
  },
  "IpStack": {
    "Url": "http://api.ipstack.com/",
    "ApiKey": "",
    "_comment": "Set via IPSTACK_API_KEY environment variable"
  },
  "SENDGRID_URGUIDE_API_KEY": "",
  "_comment_sendgrid": "Set via SENDGRID_API_KEY environment variable",
  "Stripe": {
    "PublishableKey": "",
    "SecretKey": "",
    "WebhookSecret": "",
    "_comment": "SECURITY: Set via STRIPE_PUBLISHABLE_KEY, STRIPE_SECRET_KEY, and STRIPE_WEBHOOK_SECRET environment variables. Never commit real API keys to source control."
  },
  "Azure": {
    "SignalR": {
      "Enabled": "true"
    }
  },
  "TieredRateLimit": {
    "Enabled": true,
    "EnableAnalytics": true,
    "Policies": {
      "Anonymous": {
        "Tier": "Anonymous",
        "Limit": 10,
        "Period": "1m"
      },
      "Authenticated": {
        "Tier": "Authenticated",
        "Limit": 60,
        "Period": "1m"
      },
      "Premium": {
        "Tier": "Premium",
        "Limit": 300,
        "Period": "1m"
      }
    },
    "EndpointPolicies": {
      "POST:/tour-requests": {
        "Anonymous": {
          "Tier": "Anonymous",
          "Limit": 2,
          "Period": "1h"
        },
        "Authenticated": {
          "Tier": "Authenticated",
          "Limit": 10,
          "Period": "1h"
        },
        "Premium": {
          "Tier": "Premium",
          "Limit": 50,
          "Period": "1h"
        }
      },
      "POST:/payments": {
        "Anonymous": {
          "Tier": "Anonymous",
          "Limit": 1,
          "Period": "1h"
        },
        "Authenticated": {
          "Tier": "Authenticated",
          "Limit": 5,
          "Period": "1h"
        },
        "Premium": {
          "Tier": "Premium",
          "Limit": 20,
          "Period": "1h"
        }
      }
    },
    "Exemptions": [
      "127.0.0.1",
      "::1"
    ]
  }
}