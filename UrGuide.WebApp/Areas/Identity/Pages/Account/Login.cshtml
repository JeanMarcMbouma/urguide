@page
@model LoginModel

@{
    ViewData["Title"] = "Sign In !";
}

<div class="container">

    <div class="row justify-content-center LoginGrid">
        <div class="col-10 col-sm-8 col-md-5 col-lg-4 col-xl-4">
            <h6 class="text-center"><img class="login-logo" src="~/Logo.png" /></h6>
            <section>

                <form id="account" method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <br />
                    <br />
                    <div class="form-group">

                        <input asp-for="Input.Email" class="form-control LOGINFORM" placeholder="email address" autocomplete="off" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="form-group">

                        <input asp-for="Input.Password" class="form-control LOGINFORM" placeholder="password" autocomplete="off" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <p>
                            <a id="forgot-password" href="/reset-password">Forgot password?</a>
                        </p>
                    </div>
                    <div class="form-group">
                        <button id="btnLogin" type="submit" class="btn form-control">SIGN IN</button>
                    </div>
                    <div class="form-group">
                        <p>
                            <br />
                            <span>Don't have an account yet ? <a id="forgot-password" href="/sign-up">Register </a></span>
                        </p>
                    </div>
                </form>
            </section>
        </div>
    </div>
</div>





































