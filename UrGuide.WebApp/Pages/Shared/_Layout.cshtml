<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Urguide</title>
    <link rel="stylesheet" href="~/bootstrap/dist/css/bootstrap.min.css" >
    <link rel="stylesheet" href="~/font-awesome/css/font-awesome.min.css" >
</head>
<style>
    .form-group span {
    font-size: 15px !important;
}

    #forgot-password{
         font-size: 15px !important;
    }

.LoginGrid {
    margin-top: 50px;
}

.login-logo{
       height:65px;
    width:190px;
}

input.LOGINFORM {
    height: 45px;
    border: solid 1px #ccc !important;
    outline: none;
    box-shadow: none !important;
    border-radius: 2px !important;
}

 input.LOGINFORM:focus {
        outline: none; /* Remove default outline and use border or box-shadow */
        border: solid 1px #65ade4 !important; /* Full freedom. (works also with border-radius) */
        box-shadow: 2px 2px 16px -7px #65ade4 !important;
        border-radius: 2px;
    }

span.text-danger {
    font-size: 12px;
}

#btnLogin {
    height: 40px;
    background-color: #2954ad;
    color: white;
    border-radius: 6px;
    font-weight: 600;
    font-size: 15px !important;
}

    #btnLogin:hover {
        background-color: #1a4396;
        color: whitesmoke;
    }
</style>
<body>

    <div class="container">
        @RenderBody()
    </div>
<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js" integrity="sha384-9/reFTGAW83EW2RDu2S0VKaIzap3H66lZH81PoYlFhbGU+6BZp6G7niu735Sk7lN" crossorigin="anonymous"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js" integrity="sha384-B4gt1jrGC7Jh4AgTPSdUtOBvfO8shuf57BaghqFfPlYxofvL8/KUEfYiJOMMV+rV" crossorigin="anonymous"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
